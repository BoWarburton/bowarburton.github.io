rules_version = '2';

// Security rules for blnqr. Paste into Firebase console → Firestore → Rules.
// Players sign in anonymously unless a game requires login. Making games needs Google sign-in.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function room(code) { return get(/databases/$(db)/documents/rooms/$(code)).data; }
    function isHost(code) { return signedIn() && room(code).hostUid == request.auth.uid; }
    function proposing(code) { return room(code).phase == 'propose'; }
    function me() { return [request.auth.uid].toSet(); }
    function validName(d) { return d.name is string && d.name.size() >= 1 && d.name.size() <= 24; }

    /* ---------- Team rooms ---------- */

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.phase == 'propose'
        && request.resource.data.categories.size() >= 2
        && request.resource.data.categories.size() <= 8;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.phase in ['propose', 'sort'];

      match /words/{wordId} {
        allow read: if signedIn();

        allow create: if signedIn() && proposing(code)
          && request.resource.data.keys().hasOnly(['cat', 'text', 'voters', 'removed', 'by'])
          && wordId == request.resource.data.cat + '~' + request.resource.data.text
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 24
          && request.resource.data.voters == [request.auth.uid]
          && request.resource.data.removed == false
          && request.resource.data.by == request.auth.uid;

        // The host can remove/restore words. Anyone else may only add or
        // remove their own vote while proposals are open.
        allow update: if isHost(code)
          || (signedIn() && proposing(code)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters'])
            && request.resource.data.voters.size() == request.resource.data.voters.toSet().size()
            && (request.resource.data.voters.toSet() == resource.data.voters.toSet().union(me())
              || request.resource.data.voters.toSet() == resource.data.voters.toSet().difference(me())));
      }

      match /players/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid && validName(request.resource.data);
      }
    }

    /* ---------- Games ---------- */

    function game(gameId) { return get(/databases/$(db)/documents/games/$(gameId)).data; }
    // Invite-only games are visible to their owner and the invited Google accounts.
    function canSee(g) {
      return g.visibility != 'invite' || g.ownerUid == request.auth.uid
        || (isGoogle() && request.auth.token.email.lower() in g.invites);
    }
    function canPlay(g) { return signedIn() && canSee(g) && (!g.loginRequired || isGoogle()); }
    function validGame(d) {
      return d.type in ['persona', 'flashcard', 'categorizer', 'sequencer', 'preference', 'group', 'decision']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
        && d.visibility in ['public', 'link', 'invite']
        && d.invites is list && d.invites.size() <= 500
        && d.loginRequired is bool && (d.visibility != 'invite' || d.loginRequired)
        && d.solo is bool && d.group is bool
        && d.content is map;
    }

    match /games/{gameId} {
      // Opening a game by its id works for public and secret-link games; listing
      // only ever shows public games (or your own).
      allow get: if signedIn() && (resource == null || canSee(resource.data));
      allow list: if signedIn() && (resource.data.visibility == 'public' || resource.data.ownerUid == request.auth.uid);
      allow create: if isGoogle()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.plays == 0
        && validGame(request.resource.data);
      // Owners edit their games. Players may bump the play counter by exactly one.
      allow update: if (isGoogle()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.plays == resource.data.plays
          && validGame(request.resource.data))
        || (canPlay(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
          && request.resource.data.plays == resource.data.plays + 1);
      allow delete: if isGoogle() && resource.data.ownerUid == request.auth.uid;

      // Solo results: one per player per game.
      match /results/{uid} {
        allow read: if signedIn() && canSee(game(gameId));
        allow create, update: if request.auth.uid == uid && canPlay(game(gameId))
          && validName(request.resource.data) && request.resource.data.summary is map;
        allow delete: if isGoogle() && game(gameId).ownerUid == request.auth.uid;
      }
    }

    /* ---------- Group sessions (6-letter code): any-time or live ---------- */

    match /sessions/{code} {
      function session() { return get(/databases/$(db)/documents/sessions/$(code)).data; }
      function member() { return exists(/databases/$(db)/documents/sessions/$(code)/players/$(request.auth.uid)); }

      allow read: if signedIn();
      allow create: if request.resource.data.hostUid == request.auth.uid
        && request.resource.data.live is bool
        && canPlay(game(request.resource.data.gameId))
        && game(request.resource.data.gameId).group == true;
      // Only the host runs a live session: phase (lobby → play → reveal) and round.
      allow update: if signedIn() && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase', 'round'])
        && request.resource.data.phase in ['lobby', 'play', 'reveal'];
      allow delete: if false;

      match /players/{uid} {
        allow read: if signedIn();
        allow write: if request.auth.uid == uid && validName(request.resource.data)
          && canPlay(game(session().gameId));
      }

      // Options players add to a Group pick, if its creator allows it. In a live
      // session they can only be added in the lobby. Authors and the host can remove them.
      match /options/{key} {
        allow read: if signedIn();
        allow create: if signedIn() && member()
          && game(session().gameId).allowAdd == true
          && (!session().live || session().phase == 'lobby')
          && request.resource.data.keys().hasOnly(['text', 'by'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 80;
        allow delete: if signedIn()
          && (resource.data.by == request.auth.uid || session().hostUid == request.auth.uid);
      }
    }
  }
}
